VITE_SUPABASE_URL=https://egtzpvitcgquzppvlcrj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-only — set these in Vercel, never in browser code.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://egtzpvitcgquzppvlcrj.supabase.co
SUPABASE_SECRET_KEY=

# --- CAVEN's voice (ElevenLabs) --------------------------------------------
# Free tier is ~10k characters/month, no card. Edward is already the default.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=xru6qZB94sJdkyqP12qN
# Optional: eleven_turbo_v2_5 for lower latency, at some loss of character.
ELEVENLABS_MODEL_ID=

# --- CAVEN's brain ----------------------------------------------------------
# Set ONE of these. api/chat.ts tries them fastest-first and falls back
# automatically, so extra keys are free insurance against a rate limit.
#
# Groq — free, no card, by far the fastest. Best default for voice.
#   console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio — free, no card, holds a persona well.
#   aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cerebras — free, also very fast.
#   cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter — one key, many free models (lower daily cap).
#   openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Any other OpenAI-compatible endpoint.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=

# Paid paths — optional, used only if set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_GATEWAY_API_KEY=
GATEWAY_MODEL=anthropic/claude-sonnet-4.6
